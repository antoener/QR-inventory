# Variables de entorno para desarrollo

# URL base que se codifica en los QR de las etiquetas.
# En producción cambiar por el dominio definitivo, ej: https://inv.tuempresa.com
VITE_QR_BASE_URL=http://localhost:3000

# URL base de la API. En desarrollo el proxy de Vite redirige /api a localhost:8080,
# asi que este valor solo se usa si se consume la API sin proxy.
VITE_API_BASE_URL=/api
