# Copy this file to `.env` and fill in your local values. `.env` is gitignored.
DB_URL=jdbc:mysql://localhost:3306/qr_db?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=

# JWT lifetimes
JWT_ACCESS_EXPIRATION_MIN=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Bootstrap del admin inicial (se usa solo si la tabla de usuarios esta vacia)
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=60
GLOBAL_RATE_LIMIT=200
GLOBAL_RATE_LIMIT_WINDOW=60

# Inactivity timeout (minutos)
INACTIVITY_TIMEOUT=15

# Cookies httpOnly Secure (desactivar solo en dev sobre http)
COOKIE_SECURE=true
